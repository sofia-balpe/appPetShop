@page "/CadastroCliente"

@using appPetShop.Components.RegrasDeNegocio
@inject ClienteDAO clienteDAO;
@inject NavigationManager Navigation;




  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    :root {
      --verde-escuro: #165C3C;
      --verde-medio: #6EAC88;
      --verde-botao: #11412A;
      --fundo-claro: #F5F5F5;
    }

    body {
      background-color: var(--fundo-claro);
      margin: 0;
    }

    .sidebar {
      width: 250px;
      background-color: var(--verde-escuro);
      min-height: 100vh;
    }

    .sidebar .nav-link {
      color: white;
    }

    .sidebar .nav-link.active,
    .sidebar .nav-link:hover {
      background-color: var(--verde-botao);
      color: white;
    }

    .content {
     background-color: #6EAC88; 
     min-height: 100vh;
     padding: 2rem;
     }


    header {
      background-color: var(--verde-medio);
            color: #165C3C;
    }

    .form-cadastro {
      background-color: var(--verde-medio);
      border-radius: 15px;
      padding: 2rem;
      margin-top: 3rem;
      max-width: 900px;
      color: #165C3C;
    }

    .form-cadastro input::placeholder {
     color: #165C3C;
    }

    .btn-primary {
      background-color: var(--verde-botao);
      border: none;
    }

    .btn-primary:hover {
      background-color: #0d2f1f;
    }

     
     

        .header {
            display: flex;
            align-items: center;
            gap: 15px; /* Espaço entre o título e o botão */
            margin: 20px 40px;
        }

            .header h1 {
                margin: 0;
                font-size: 35px;
                font-weight: bold;
                color: #1a4c33; /* cor igual à segunda página */
            }

        .btn-voltar {
            background-color: #0b3d2e;
            color: white;
            border: none;
            padding: 10px 20px;
            cursor: pointer;
            border-radius: 5px;
        }


  </style>



  <div class="d-flex">

        <div class="content flex-grow-1" style="background:#f4f4f4">
    

      <main class="d-flex justify-content-center align-items-center flex-column" >

                <div class="header">
                    <a href="menu"><button class="btn-voltar">Voltar</button></a>
               
                    <h1>Cadastro de Clientes</h1>
                </div>

               
         <EditForm Model="@_novoCliente" OnValidSubmit="@Salvar">

          <div class="row">
            <div class="col-md-6 mb-3">
                <input @bind-value="_novoCliente!.Nome" type="text" class="form-control" placeholder="Nome completo">
            </div>

            <div class="col-md-6 mb-3">
                <input @bind-value="_novoCliente!.CPF" type="text" class="form-control" placeholder="CPF">
            </div>

            <div class="col-md-6 mb-3">
                <input @bind-value="_novoCliente!.CEP" type="text" class="form-control" placeholder="CEP">
            </div>
            <div class="col-md-6 mb-3">
                 <input @bind-value="_novoCliente!.Bairro" type="text" class="form-control" placeholder="Bairro">
            </div>

            <div class="col-md-6 mb-3">
                <input @bind-value="_novoCliente!.NumeroCasa" type="text" class="form-control" placeholder="Número">
            </div>
            <div class="col-md-6 mb-3">
                <input @bind-value="_novoCliente!.Complemento" type="text" class="form-control" placeholder="Complemento">
            </div>

            <div class="col-md-6 mb-3">
                <input @bind-value="_novoCliente!.Telefone" type="text" class="form-control" placeholder="Telefone">
            </div>

            <div class="col-md-6 mb-3">
                <input @bind-value="_novoCliente!.Email" type="email" class="form-control" placeholder="E-Mail">
            </div>

            <div class="col-md-6 mb-3">   
                <input @bind-value="_novoCliente!.DataNasc" type="text" class="form-control" placeholder="Data de nascimento">
            </div>

            <div class="col-12 mt-3 text-end">
              <input type="submit" class="btn btn-primary px-4" value="Cadastrar">
            </div>
          </div>

        </EditForm>>


      </main>
    </div>
  </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">



@code {
    private string? erro = null;

    [SupplyParameterFromForm]
    private Cliente? _novoCliente { get; set; } = new();

    private void Salvar()
    {

        try
        {
            if (_novoCliente.Nome is null || _novoCliente.Nome == "")
            {
                throw new Exception(message: "O campo nome é obrigatório");
            }

            clienteDAO.Inserir(_novoCliente);

            Navigation.NavigateTo(uri: "/clientes");
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
    }
}

