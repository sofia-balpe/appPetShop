@page "/CadastroCliente"
<h3>Cadastro de Cliente</h3>

<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cadastro de Cliente - Pet Planet</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    :root {
      --verde-escuro: #165C3C;
      --verde-medio: #6EAC88;
      --verde-botao: #11412A;
      --fundo-claro: #F5F5F5;
    }

    body {
      background-color: var(--fundo-claro);
      margin: 0;
    }

    .sidebar {
      width: 250px;
      background-color: var(--verde-escuro);
      min-height: 100vh;
    }

    .sidebar .nav-link {
      color: white;
    }

    .sidebar .nav-link.active,
    .sidebar .nav-link:hover {
      background-color: var(--verde-botao);
      color: white;
    }

    .content {
     background-color: #6EAC88; 
     min-height: 100vh;
     padding: 2rem;
     }


    header {
      background-color: var(--verde-medio);
      color: white;
    }

    .form-cadastro {
      background-color: var(--verde-medio);
      border-radius: 15px;
      padding: 2rem;
      margin-top: 3rem;
      max-width: 900px;
      color: white;
    }

    .form-cadastro input::placeholder {
      color: #eeeeee;
    }

    .btn-primary {
      background-color: var(--verde-botao);
      border: none;
    }

    .btn-primary:hover {
      background-color: #0d2f1f;
    }

  </style>
</head>

<body>
  <div class="d-flex">

    <div class="content flex-grow-1">
    
      <header class="d-flex justify-content-end align-items-center p-3 border-bottom">
        <i class="bi bi-gear fs-4 me-3"></i>
        <i class="bi bi-list fs-4 me-3"></i>
        <i class="bi bi-box-arrow-right fs-4"></i>
      </header>

      <main class="d-flex justify-content-center align-items-center flex-column">
        <form class="form-cadastro container-fluid">
          <div class="row">
            <div class="col-md-6 mb-3">
              <input type="text" class="form-control" placeholder="Nome completo">
            </div>
            <div class="col-md-6 mb-3">
              <input type="text" class="form-control" placeholder="CPF">
            </div>

            <div class="col-md-6 mb-3">
              <input type="text" class="form-control" placeholder="CEP">
            </div>
            <div class="col-md-6 mb-3">
              <input type="text" class="form-control" placeholder="Bairro">
            </div>

            <div class="col-md-6 mb-3">
              <input type="text" class="form-control" placeholder="Número">
            </div>
            <div class="col-md-6 mb-3">
              <input type="text" class="form-control" placeholder="Complemento">
            </div>

            <div class="col-md-6 mb-3">
              <input type="text" class="form-control" placeholder="Telefone">
            </div>
            <div class="col-md-6 mb-3">
              <input type="email" class="form-control" placeholder="E-Mail">
            </div>

            <div class="col-md-6 mb-3">
              <input type="date" class="form-control" placeholder="Data de nascimento">
            </div>

            <div class="col-12 mt-3 text-end">
              <input type="submit" class="btn btn-primary px-4" value="Cadastrar">
            </div>
          </div>
        </form>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>