@page "/CadastroDeProduto"
@using appPetShop.Components.RegrasDeNegocio
@using appPetShop.Configs
@inject ProdutoDAO produtoDAO;
@inject NavigationManager Navigation;

@if (erro != null)
{
    <div class="alert alert-danger">
        @erro
    </div>
}

<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Bootstrap demo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
      <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      
    }


    .sidebar .nav-link {
      color: white;
    }

    .sidebar .nav-link:hover {
      background-color: #165C3C;
    }

    .logo-top {
      width: 100%;
      max-width: 150px;
      margin-bottom: 2rem;
    }

   .content {
     background-color: #6EAC88;
     min-height: 100vh;
     padding: 2rem;
    }

    header {
      background-color: #6EAC88;
    }

    .cadastro {
      margin-top: 2rem;
      color: #165C3C;
    }

    .form-cadastro {
      background-color: #6EAC88;
      padding: 2rem;
      border-radius: 12px;
      max-width: 600px;
      margin: 2rem auto;
      color: #165C3C;
    }

    .form-cadastro label {
      font-weight: bold;
      margin-top: 1rem;
    }

    .form-cadastro input {
      margin-bottom: 1rem;
    }

    .btn-cadastrar button {
      background-color: #11412A;
      color: #fff;
      padding: 0.5rem 1.5rem;
      border: none;
      border-radius: 5px;
      margin-top: 1rem;
    }

    .linha {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .linha input {
      flex: 1;
    }

        .header {
            display: flex;
            align-items: center;
            gap: 20px; /* Espaço entre o título e o botão */
            margin: 20px;
        }

            .header h1 {
                margin: 0;
                font-size: 35px;
                font-weight: bold;
                color: #1a4c33; /* cor igual à segunda página */
            }

        .btn-voltar {
            background-color: #0b3d2e;
            color: white;
            border: none;
            padding: 10px 20px;
            cursor: pointer;
            border-radius: 5px;
        }
    
 
  </style>
</head>
<body >
    <div class="d-flex" style="background:#f4f4f4">
      

        <div class="content flex-grow-1" style="background:#f4f4f4">
            

            <div class="container">
                <div class="header">
                    <a href="menu"> <button class="btn-voltar">Voltar</button></a>
                    <h1>Cadastro de Produtos</h1>
                </div>
                

                <form class="form-cadastro">
                    <div class="linha">
                        <div class="flex-fill">
                            <label for="nome">Nome:</label>
                            <input type="text" id="nome" class="form-control">
                        </div>
                        <div class="flex-fill">
                            <label for="descricao">Descrição:</label>
                            <input type="text" id="descricao" class="form-control">
                        </div>
                    </div>

                    <div class="linha">
                        <div class="flex-fill">
                            <label for="quantidade">Quantidade:</label>
                            <input type="number" id="quantidade" class="form-control">
                        </div>
                        <div class="flex-fill">
                            <label for="valor">Valor Unitário:</label>
                            <input type="number" step="0.01" id="valor" class="form-control">
                        </div>
                    </div>

                    <div class="btn-cadastrar text-end">
                        <button type="submit">Cadastrar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</body>
</html>

@code {
    private string? erro = null;

    [SupplyParameterFromForm]
    private Produto? _novoProduto { get; set; } = new();

    private void Salvar()
    {

        try
        {
            if (_novoProduto.Nome is null || _novoProduto.Nome == "")
            {
                throw new Exception(message: "O campo nome é obrigatório");
            }

            produtoDAO.Inserir(_novoProduto);

            Navigation.NavigateTo(uri: "/produtos");
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
    }
}

