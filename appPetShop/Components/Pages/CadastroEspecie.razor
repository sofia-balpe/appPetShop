@page "/CadastroDeEspecie"
@using appPetShop.Components.RegrasDeNegocio
@using appPetShop.Configs
@inject EspecieDAO especieDao
@inject NavigationManager Navigation
@rendermode InteractiveServer

@if (erro != null)
{
    <div class="alert alert-danger">
        @erro
    </div>
}


<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bootstrap demo</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

<style>
    :root {
        --verde-escuro: #165C3C;
        --verde-medio: #6EAC88;
        --verde-botao: #11412A;
        --fundo-claro: #F5F5F5;
    }

    body {
        background-color: var(--fundo-claro);
        margin: 0;
    }

    .sidebar {
        width: 250px;
        background-color: var(--verde-escuro);
        min-height: 100vh;
    }

        .sidebar .nav-link {
            color: white;
        }

            .sidebar .nav-link.active,
            .sidebar .nav-link:hover {
                background-color: var(--verde-botao);
                color: white;
            }

    .content {
        background-color: #6EAC88;
        min-height: 100vh;
        padding: 2rem;
    }


    header {
        background-color: var(--verde-medio);
        color: #165C3C;
    }

    .form-cadastro {
        background-color: var(--verde-medio);
        border-radius: 15px;
        padding: 2rem;
        margin-top: 3rem;
        max-width: 900px;
        color: #165C3C;
    }

        .form-cadastro input::placeholder {
            color: #165C3C;
        }

    .btn-primary {
        background-color: var(--verde-botao);
        border: none;
    }

        .btn-primary:hover {
            background-color: #0d2f1f;
        }




    .header {
        display: flex;
        align-items: center;
        gap: 15px; /* Espaço entre o título e o botão */
        margin: 20px 40px;
    }

        .header h1 {
            margin: 0;
            font-size: 35px;
            font-weight: bold;
            color: #1a4c33; /* cor igual à segunda página */
        }

    .btn-voltar {
        background-color: #0b3d2e;
        color: white;
        border: none;
        padding: 10px 20px;
        margin-left: -40px;
        cursor: pointer;
        border-radius: 5px;
    }

</style>

<div class="d-flex" style="background:#f4f4f4">


    <div class="content flex-grow-1" style="background:#f4f4f4">


        <div class="container">
            <div class="header">
                <a href="menu"> <button class="btn-voltar">Voltar</button></a>
                <h1>Cadastro de Especie</h1>
            </div>


            <EditForm Model="_novoEspecie" OnSubmit="Salvar">

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label>Nome</label>
                        <input @bind-value="_novoEspecie!.Nome" type="text" class="form-control">
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Nome Científico</label>
                        <input @bind-value="_novoEspecie!.NomeCientifico" type="text" class="form-control">
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Alimento</label>
                        <input @bind-value="_novoEspecie!.Alimento" type="text" class="form-control">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label>Habitat</label>
                        <input @bind-value="_novoEspecie!.Habitat" type="text" class="form-control">
                    </div>

                    <div class="col-12 mt-3 text-end">
                        <input type="submit" class="btn btn-primary px-4" value="Cadastrar">
                    </div>
                </div>

            </EditForm>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">


@code {
    private string? erro = null;

    [SupplyParameterFromForm]
    private Especie? _novoEspecie { get; set; } = new();

    private void Salvar()
    {

        try
        {
            especieDao.Inserir(_novoEspecie);

            Navigation.NavigateTo(uri: "/ListarEspecies");
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
    }
}

