@page "/ListarClientes"
@using appPetShop.Components.RegrasDeNegocio
@inject ClienteDAO clienteDao
@inject NavigationManager Navigation;
<h3>Lista de Clientes</h3>


    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lista de Clientes - Pet Planet</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        :root {
            --verde-escuro: #165C3C;
            --verde-medio: #6EAC88;
            --verde-botao: #11412A;
            --fundo-claro: #F5F5F5;
        }

        body {
            background-color: var(--fundo-claro);
            margin: 0;
        }

        .sidebar {
            width: 250px;
            background-color: var(--verde-escuro);
            min-height: 100vh;
        }

            .sidebar .nav-link {
                color: white;
            }

                .sidebar .nav-link.active,
                .sidebar .nav-link:hover {
                    background-color: var(--verde-botao);
                    color: white;
                }

        .content {
            background-color: #6EAC88;
            min-height: 100vh;
            padding: 2rem;
        }

        header {
            background-color: var(--verde-medio);
            color: white;
        }

        .tabela-clientes {
            background-color: white;
            border-radius: 15px;
            padding: 2rem;
            margin-top: 3rem;
            max-width: 1000px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }

        .btn-edit {
            background-color: var(--verde-botao);
            color: white;
        }

            .btn-edit:hover {
                background-color: #0d2f1f;
            }

        .btn-delete {
            background-color: #dc3545;
            color: white;
        }

            .btn-delete:hover {
                background-color: #b02a37;
            }

    </style>


            <header class="d-flex justify-content-end align-items-center p-3 border-bottom">
                <i class="bi bi-gear fs-4 me-3"></i>
                <i class="bi bi-list fs-4 me-3"></i>
                <i class="bi bi-box-arrow-right fs-4"></i>
            </header>


            <table class="table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Nome</th>
                        <th>CPF</th>
                        <th>CEP</th>
                        <th>Rua</th>
                        <th>Bairro</th>
                        <th>Número</th>
                        <th>Complemento</th>
                        <th>Telefone</th>
                        <th>E-Mail</th>
                        <th>Data de Nascimento</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int contador = 1;
                       

                        @foreach (var cliente in listaClientes)
                        {
                            <tr>
                                <td>@cliente.Id</td>
                                <td>@cliente.Nome</td>
                                <td>@cliente.CPF</td>
                                <td>@cliente.CEP</td>
                                <td>@cliente.Rua</td>
                                <td>@cliente.Bairro</td>
                                <td>@cliente.NumeroCasa</td>
                                <td>@cliente.Complemento</td>
                                <td>@cliente.Telefone</td>
                                <td>@cliente.Email</td>
                                <td>@cliente.DataNasc</td>
                                <td><button class="btn btn-edit me-2" @onclick="() => Editar(cliente.Id)">Editar</button></td>
                                <td><button class="btn btn-delete" @onclick="() => DeletarCliente(cliente.Id)">Deletar</button></td>
                            </tr>

                            contador++;
                        }
                    }
                </tbody>
            </table>
    @code {
        private List<Cliente> listaClientes = new();
        protected override void OnInitialized()
        {
            CarregarClientes();
        }
        private void CarregarClientes()
        {
            listaClientes = clienteDao.ListarTodos();
        }

        private void DeletarCliente(int id)
        {
        
            clienteDao.Deletar(id);
            CarregarClientes();
            StateHasChanged();
        }
        private void Editar(int id)
        {
            Navigation.NavigateTo($"/EditarCliente/{id}");
        }   
    }
           

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
