@page "/ListarPets"

@using appPetShop.Components.RegrasDeNegocio
@inject PetDAO petDAO
@inject NavigationManager Navigation
@rendermode InteractiveServer

<h3>Lista de Pets</h3>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

<style>
    :root {
        --verde-escuro: #165C3C;
        --verde-medio: #6EAC88;
        --verde-botao: #11412A;
        --fundo-claro: #F5F5F5;
    }

    body {
        background-color: var(--fundo-claro);
        margin: 0;
    }

    .sidebar {
        width: 250px;
        background-color: var(--verde-escuro);
        min-height: 100vh;
    }

        .sidebar .nav-link {
            color: white;
        }

            .sidebar .nav-link.active,
            .sidebar .nav-link:hover {
                background-color: var(--verde-botao);
                color: white;
            }

    .content {
        background-color: #6EAC88;
        min-height: 100vh;
        padding: 2rem;
    }

    header {
        background-color: var(--verde-medio);
        color: white;
    }

    .tabela-clientes {
        background-color: white;
        border-radius: 15px;
        padding: 2rem;
        margin-top: 3rem;
        max-width: 1000px;
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }

    .btn-edit {
        background-color: var(--verde-botao);
        color: white;
    }

        .btn-edit:hover {
            background-color: #0d2f1f;
        }

    .btn-delete {
        background-color: #dc3545;
        color: white;
    }

        .btn-delete:hover {
            background-color: #b02a37;
        }

</style>


<header class="d-flex justify-content-end align-items-center p-3 border-bottom">
    <a href="CadastroDePet"> <button class="btn-voltar">Adicionar</button></a>

</header>


<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Espécie</th>
            <th>Raça</th>
            <th>Data de Nascimento</th>
            <th>Cliente/Tutor</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @{
            int contador = 1;


            @foreach (var pet in listaPets)
            {
                <tr>
                    <td>@pet.Id</td>
                    <td>@pet.Nome</td>
                    <td>@pet.Especie</td>
                    <td>@pet.Raca</td>
                    <td>@pet.Data_Nascimento</td>                 
                    <td>@pet.NomeCliente</td>
                    <td><button class="btn btn-edit me-2" @onclick="() =>Editar(pet.Id)">Editar</button>
                    <button class="btn btn-delete" @onclick="() => Deletar(pet.Id)">Deletar</button>
                    <button class="btn btn-info me-2" @onclick="() => Visualizar(pet.Id)">Visualizar</button>
                    </td>
                </tr>

                contador++;
            }
        }
    </tbody>
</table>
@code {
    private List<Pet> listaPets = new();
    protected override void OnInitialized()
    {
        CarregarProdutos();
    }
    private void CarregarProdutos()
    {
        listaPets = petDAO.ListarTodos();
    }

    private void Deletar(int id)
    {
       petDAO.Deletar(id);
        CarregarProdutos();
        StateHasChanged();
    }

    private void Editar(int id)
    {
        Navigation.NavigateTo($"/EditarPet/{id}");
    }

    private void Visualizar(int id)
    {
        Navigation.NavigateTo($"/VerPet/{id}");
    }
}


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>