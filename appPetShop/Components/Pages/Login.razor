@page "/Login"
<h3>MenuInicial</h3>

    <!doctype html>
<html lang="pt-br">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Bootstrap demo</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
  <link rel="stylesheet" href="style.css">
</head>

<body>
  <div class="container-fluid text-center h-100">
    <div class="row h-100">
      <div class="col d-flex justify-content-center align-items-center" style="background-color: rgb(244, 244, 244);">
        <img src="imgOsso.png" alt="" class="w-50 h-auto">

      </div>

      <div class="col align-items-center d-flex justify-content-center" style="background-color: rgb(23, 93, 59);">
        <br>
        <form style="background-color: #6BAC84;" class="mt-4 mb-4 rounded-5 p-5">
          <img src="imgPata.png" alt="" class="img-fluid">
          <div class="mb-3">
            <br>
            <input id="inputUser" type="text" class="form-control" aria-describedby="emailHelp"
              placeholder="Nome de Usuário">
          </div>

          <div class="mb-3">
            <input id="inputPassword" type="password" class="form-control"
              placeholder="Senha de Usuário">
          </div>

          <div class="mb-3 form-check text-start">
            <input type="checkbox" class="form-check-input" id="exampleCheck1" >
            <label class="form-check-label text-light" for="exampleCheck1">Lembre-me</label>
          </div>

          <button type="submit" class="btn btn-primary"
            style="background-color: #124D31; border: none; margin-bottom: 10px;">Login</button>



        </form>
      </div>

    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q" crossorigin="anonymous">
  </script>
</body>

</html>