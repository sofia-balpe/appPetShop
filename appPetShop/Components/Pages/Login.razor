@page "/"

<!doctype html>
<html lang="pt-br">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Bootstrap demo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
    <div class="container-fluid min-vh-100 d-flex justify-content-center align-items-center"
         style="background-color: rgb(23, 93, 59);">

        <form style="background-color: #6BAC84; max-width: 450px;"
              class="rounded-5 p-5 text-center w-100">

            <h2 class="text-light mb-4">Login</h2>

            <div class="mb-3">
                <input id="inputUser" type="text" class="form-control form-control-lg"
                       placeholder="Nome de Usuário">
            </div>

            <div class="mb-3">
                <input id="inputPassword" type="password" class="form-control form-control-lg"
                       placeholder="Senha de Usuário">
            </div>

            <div class="mb-3 form-check text-start">
                <input type="checkbox" class="form-check-input" id="exampleCheck1">
                <label class="form-check-label text-light" for="exampleCheck1">
                    Lembre-me
                </label>
            </div>

            <a href="menu" class="d-block mt-4">
                <button type="submit" class="btn btn-primary btn-lg w-100"
                        style="background-color: #124D31; border: none;">
                    Login
                </button>
            </a>

        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>