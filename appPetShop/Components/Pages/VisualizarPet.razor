@page "/VerPet/{id:int}"
@using appPetShop.Components.RegrasDeNegocio
@inject PetDAO petDAO
@inject NavigationManager Navigation

<h3 class="titulo">Detalhes do Pet</h3>

@if (pet == null)
{
    <p>Carregando...</p>
}
else
{
    <a href="/ListarPets"><button class="btn-voltar">Voltar</button></a>

    <div class="card-cliente">

        <p><strong>ID:</strong> @pet.Id</p>
        <p><strong>Nome:</strong> @pet.Nome</p>
        <p><strong>Espécie:</strong> @pet.NomeEspecie</p>
        <p><strong>Raça:</strong> @pet.Raca</p>
        <p><strong>Data de Nascimento:</strong> @pet.Data_Nascimento</p>
        <p><strong>Idade:</strong> @pet.Idade</p>
        <p><strong>Porte:</strong> @pet.Porte</p>
        <p><strong>Peso:</strong> @pet.Peso</p>
        <p><strong>Tutor:</strong> @pet.NomeCliente</p>

    </div>
}

@code {
    [Parameter] public int id { get; set; }

    private Pet? pet;

    protected override void OnInitialized()
    {
        pet = petDAO.ListarTodos().FirstOrDefault(p => p.Id == id);
    }

    private void Voltar()
    {
        Navigation.NavigateTo("/ListarPets");
    }
}

<style>
    body {
        margin: 0;
        background-color: #F5F5F5;
        font-family: Arial, sans-serif;
    }

    .titulo {
        text-align: center;
        margin-top: 30px;
        color: #165C3C;
        font-size: 32px;
        font-weight: bold;
    }

    .card-cliente {
        background: white;
        width: 600px;
        margin: 40px auto;
        padding: 25px;
        border-radius: 15px;
        box-shadow: 0 0 10px rgba(0,0,0,0.15);
        font-size: 18px;
        line-height: 1.6;
        color: #165C3C;
    }

    .btn-voltar {
        margin-top: 20px;
        background-color: #11412A;
        color: white;
        border: none;
        padding: 8px 20px;
        border-radius: 8px;
        cursor: pointer;
    }

        .btn-voltar:hover {
            background-color: #0d2f1f;
        }
</style>
